# BrickLink valuation settings.
#
# Preferred: official BrickLink Price Guide API (needs SELLER status).
# Register a consumer at
#   https://www.bricklink.com/v2/api/register_consumer.page
# then fill these in. The access token must whitelist the IP of the machine
# running this app.
# BRICKLINK_CONSUMER_KEY=
# BRICKLINK_CONSUMER_SECRET=
# BRICKLINK_TOKEN=
# BRICKLINK_TOKEN_SECRET=
#
# Fallback: public catalogPG.asp scrape (no account). BrickLink's AWS WAF often
# blocks this now (HTTP 202 challenge), so Estimate value will fail until API
# keys are set. Scraping is also against BrickLink ToS — personal use only.
# To disable the scrape entirely, uncomment:
# BRICKLINK_DISABLE_SCRAPE=1

# --- Optional tuning (defaults shown) ---
# BRICKLINK_CURRENCY=USD
# BRICKLINK_GUIDE_TYPE=sold     # "sold" (last 6 months) or "stock" (current listings)
# BRICKLINK_CONDITION=U         # "U" used or "N" new

# --- Conveyor / feeder (Component 2, WiFi HTTP) ---
# UNO R4 WiFi control page (home LAN or softAP 192.168.4.1):
FEEDER_BASE_URL=http://192.168.4.30

# --- igus ReBeL / CRI (Component 4, Mac development) ---
# Factory ethernet IP (fixed — robot ignores DHCP):
ROBOT_IP=192.168.3.11
# ROBOT_CRI_PORT=3920
# Optional move-test tuning:
# ROBOT_MOVE_DZ_MM=25
# ROBOT_MOVE_VEL_MM_S=15
